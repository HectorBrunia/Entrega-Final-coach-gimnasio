# URL de PostgreSQL (driver asyncpg)
DATABASE_URL=postgresql+asyncpg://coach:coach@localhost:5432/coach
# URL de Redis (checkpointer de LangGraph)
REDIS_URL=redis://localhost:6379/0
# URL de Qdrant
QDRANT_URL=http://localhost:6333
# Nombre de la coleccion de ejercicios en Qdrant
QDRANT_COLLECTION=ejercicios
# API key de Google (Gemini); no versionar el valor real. Opcional: sin ella (o sin GEMINI_MODEL)
# todo arranca y /chat y /hitl responden 503 explicando que falta configurarla.
GOOGLE_API_KEY=
# Identificador del modelo Gemini a usar (p. ej. el que indique la consigna del curso)
GEMINI_MODEL=
# Limite de peticiones por minuto a Gemini
GEMINI_RPM=14
# Reintentos ante errores transitorios del modelo (429 y 5xx), con espera exponencial
LLM_REINTENTOS=3
# Espera base en segundos (se duplica en cada reintento)
LLM_ESPERA_BASE=2.0
# Espera maxima entre reintentos, en segundos
LLM_ESPERA_MAX=20.0
# Endpoint del collector de Phoenix (trazas OpenTelemetry)
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
# Maximo de reintentos del nodo de seguridad
MAX_REINTENTOS_SEGURIDAD=2
# Identificador del modelo de embeddings
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Modelo BM25 disperso de fastembed (vectores dispersos del RAG hibrido)
BM25_MODELO=Qdrant/bm25
# Idioma del BM25 disperso (stemming y stopwords de fastembed)
BM25_IDIOMA=spanish
# Ruta del catalogo de ejercicios (JSON free-exercise-db); si falta, las rutas que lo usan responden 503
CATALOGO_PATH=data/catalogo/exercises.json
# Carpeta de las guias en Markdown que se ingieren en Qdrant junto al catalogo
GUIAS_DIR=data/guias
# Solo pruebas de integracion: el nombre de la base DEBE terminar en _test (se vacia al terminar)
# TEST_DATABASE_URL=postgresql+asyncpg://coach:coach@localhost:5432/coach_test
# Puertos del host para docker compose (solo si los de por defecto estan ocupados)
# API_PORT=8000
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# QDRANT_PORT=6333
# PHOENIX_PORT=6006
